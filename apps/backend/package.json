{
	"name": "backend",
	"version": "0.0.1",
	"description": "ReguRoute Backend (Fastify)",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"test": "echo \"Error: no test specified\" && exit 1",
		"migrate:create": "node-pg-migrate -m migrations create -j ts",
		"migrate:up": "rm -rf dist-migrations-build && pnpm tsc -p tsconfig.migrations.json && node-pg-migrate -m dist-migrations-build/migrations up",
		"migrate:down": "rm -rf dist-migrations-build && pnpm tsc -p tsconfig.migrations.json && node-pg-migrate -m dist-migrations-build/migrations down"
	},
	"keywords": [],
	"author": "",
	"dependencies": {
		"@fastify/jwt": "^8.0.1",
		"@fastify/postgres": "^5.2.2",
		"bcryptjs": "^2.4.3",
		"dotenv": "^16.4.5",
		"fastify": "^4.28.1",
		"fastify-plugin": "^5.0.1",
		"node-pg-migrate": "^8.0.3",
		"pg": "^8.12.0",
		"@reguroute/types": "workspace:*"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^18.19.39",
		"@types/pg": "^8.11.6",
		"ts-node": "^10.9.2"
	}
}