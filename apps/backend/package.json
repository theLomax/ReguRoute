{
	"name": "backend",
	"version": "1.0.0",
	"description": "ReguRoute Backend (Fastify)",
	"main": "dist/index.js",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "ts-node-dev --respawn --transpile-only --project tsconfig.json src/index.ts",
		"start": "node dist/index.js",
		"test": "echo \"Error: no test specified\" && exit 1",
		"migrate:create": "node-pg-migrate -m migrations create -j ts",
		"migrate:up": "NODE_OPTIONS='--loader ts-node/esm' node-pg-migrate -r dotenv/config -m migrations up",
		"migrate:down": "NODE_OPTIONS='--loader ts-node/esm' node-pg-migrate -r dotenv/config -m migrations down"
	},
	"keywords": [],
	"author": "",
	"dependencies": {
		"@fastify/postgres": "^5.2.2",
		"dotenv": "^16.4.5",
		"fastify": "^4.28.1",
		"node-pg-migrate": "^8.0.3",
		"pg": "^8.12.0"
	},
	"devDependencies": {
		"@types/node": "^18.19.39",
		"@types/pg": "^8.11.6",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"typescript": "^5.5.2"
	}
}
