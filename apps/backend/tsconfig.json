{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "dist",
		"module": "NodeNext",
		"rootDir": ".",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*.ts",
		"migrations/**/*.ts"
	],
	"exclude": [
		"node_modules"
	],
	"ts-node": {
		"transpileOnly": true
	}
}